# Copy to .env (gitignored) and fill in. Used by config.py / services/google_places.py.

# Server-side Google Maps key. Needs these APIs enabled on the key:
#   - Places API (New)
#   - Geocoding API
# Restrict it by API + (ideally) IP. Keep it OFF the mobile client.
GOOGLE_MAPS_API_KEY=

# Optional tuning (defaults shown):
# PLACES_DEFAULT_RADIUS_M=900
# PLACES_CACHE_TTL_S=120
