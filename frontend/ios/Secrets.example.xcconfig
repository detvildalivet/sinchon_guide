// Copy this file to `Secrets.xcconfig` (gitignored) and fill in your iOS Google Maps SDK key.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// Then wire it up ONCE in Xcode (the .xcodeproj is not edited by this repo):
//   1. Open ios/tablemate.xcworkspace in Xcode.
//   2. Select the project (top of the navigator) → "tablemate" PROJECT → Info tab.
//   3. Under "Configurations", expand Debug and Release and set the project-level
//      configuration file to `Secrets` for each (or import this xcconfig).
//   4. Info.plist already exposes GMSApiKey = $(GOOGLE_MAPS_API_KEY); AppDelegate reads it.
//
// The value below is substituted into GMSApiKey at build time.
GOOGLE_MAPS_API_KEY = YOUR_IOS_GOOGLE_MAPS_SDK_KEY
